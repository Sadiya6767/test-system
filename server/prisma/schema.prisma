generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("Administrator")
  createdAt DateTime @default(now())
}

model Question {
  id           Int      @id @default(autoincrement())
  track        String   @default("SALES_ENGINEER") // SALES_ENGINEER, HR_RECRUITER, DIGITAL_MARKETING
  section      String   @default("Web Development") // Web Development, Sales Engineer, HR Recruiter, Digital Marketing
  order        Int      @default(0)
  questionText String
  optionA      String
  optionB      String
  optionC      String
  optionD      String
  correctAnswer String
  createdAt    DateTime @default(now())
  answers      Answer[]

  @@index([track])
}

model TestAttempt {
  id             String    @id @default(uuid())
  candidateName  String
  email          String
  phone          String?
  college        String?
  course         String?
  branch         String?
  passingYear    String?
  currentCity    String?
  resumeUrl      String?
  track          String    @default("Web Developer cum Sales Engineer")
  score          Int       @default(0)
  totalQuestions Int       @default(15)
  correctAnswers Int       @default(0)
  wrongAnswers   Int       @default(0)
  unanswered     Int       @default(0)
  percentage     Float     @default(0)
  status         String    @default("INCOMPLETE")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  answers        Answer[]
  resume         CandidateResume?

  @@index([email])
  @@index([status])
  @@index([track])
  @@index([startedAt])
}

model CandidateResume {
  id        String      @id @default(uuid())
  attemptId String      @unique
  attempt   TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  filename  String
  mimetype  String
  data      String
  size      Int         @default(0)
  createdAt DateTime    @default(now())
}

model Answer {
  id             String      @id @default(uuid())
  attemptId      String
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     Int
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer String?
  correctAnswer  String
  isCorrect      Boolean     @default(false)
  answered       Boolean     @default(false)
  timeTaken      Float       @default(0)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}